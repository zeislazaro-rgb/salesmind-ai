# === LLM Open-Source (escolha UM dos provedores gratuitos) ===

# Opção 1: DeepSeek API (gratuito com limites generosos)
LLM_API_KEY=sk-sua-chave-deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Opção 2: SiliconFlow (Qwen3.8 gratuito)
# LLM_API_KEY=sk-sua-chave-siliconflow
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen3.8-72B-Instruct

# Opção 3: Together.ai (DeepSeek/Qwen gratuito)
# LLM_API_KEY=sua-chave-together
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V4

# === Backend ===
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# === Frontend ===
# O site chama /api/* e o Next repassa para a API. Só mude se a API estiver em outro endereço:
# API_INTERNAL_URL=http://localhost:3001

# === Supabase (free tier) ===
# NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key