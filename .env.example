# Copie este arquivo para .env (na raiz do projeto) e preencha.
# O .env NUNCA deve ir para o GitHub (já está no .gitignore).

# === LLM Open-Source (escolha UM dos provedores) ===

# Opção 1: DeepSeek
LLM_API_KEY=sk-sua-chave-deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Opção 2: SiliconFlow (Qwen)
# LLM_API_KEY=sk-sua-chave-siliconflow
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen3.8-72B-Instruct

# Opção 3: Together.ai
# LLM_API_KEY=sua-chave-together
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V4

# === Site (apps/web) ===
# Sem API_INTERNAL_URL, o site chama a LLM direto (usando as variáveis acima).
# Para usar a API separada (apps/api), descomente:
# API_INTERNAL_URL=http://localhost:3001

# === API (apps/api) ===
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
# Token secreto para as rotas /admin/* (header x-admin-token). Sem ele, admin fica bloqueado.
# ADMIN_TOKEN=troque-por-um-texto-longo-e-aleatorio

# === Supabase (opcional, ainda não integrado) ===
# NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
